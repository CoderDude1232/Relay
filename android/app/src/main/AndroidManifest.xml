<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required from API 33 to show the notification a push wake produces. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Calls. Android has no PushKit: a call wake rings by starting a foreground
      service and posting a full-screen-intent notification.
        - MANAGE_OWN_CALLS is what qualifies this app to use the phoneCall
          foreground-service type without being the default dialer.
        - USE_FULL_SCREEN_INTENT is granted by default to apps in the calling
          category from API 34; without it the call still posts as a heads-up
          notification, it just cannot wake the screen.
      All four are install-time permissions - none of them prompt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Call media. Both are runtime permissions. Without the microphone a call
      would connect and carry silence, so the transport refuses to start rather
      than let the user blame the other end; without the camera a video call
      quietly downgrades to audio.
    -->
    <!--
      Contact discovery. Addresses are blinded on-device before any lookup, so
      the relay never learns who is in the address book.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      Screen sharing. From Android 14 a foreground service with the
      mediaProjection type must already be running before the projection may
      start, so CallService re-promotes itself with the extra type first.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- A phone with no camera can still place and take audio calls. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".RelayApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Relay">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Relay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A contact link, however it arrived: scanned from a QR, tapped in
              a message, or read off an NFC tag. All three carry the same URL,
              so one filter covers them.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="relaymsg.app" android:pathPrefix="/add/" />
                <data android:scheme="https" android:host="relaymsg.app" android:pathPrefix="/c/" />
                <data android:scheme="https" android:host="relaymsg.app" android:pathPrefix="/g/" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="relay" android:host="add" />
            </intent-filter>

            <!--
              Where the Google sign-in browser tab hands back. singleTop above is
              what routes it to the running instance via onNewIntent instead of
              stacking a second copy of the app behind the tab.

              A private-use scheme, so any app could claim it. That is exactly
              why the flow is PKCE: an intercepted code is worthless without the
              verifier, which never leaves this process.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="app.relaymsg" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
          Android's Share Extension: anything shared from another app lands
          here. Also the target dynamic sharing shortcuts point at, which is
          what puts recent conversations at the top of the share sheet.
        -->
        <activity
            android:name=".share.ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Relay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          The screen a call's full-screen intent raises. It lives in its own task
          and outside recents: it is a transient interruption, not somewhere the
          user navigates back to.
        -->
        <activity
            android:name=".call.IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Relay"
            android:turnScreenOn="true" />

        <!--
          Holds the process alive while a call rings and runs. phoneCall is the
          type that matches what it does, and the one whose Doze and
          background-start behaviour is written for exactly this case.
        -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|mediaProjection" />

        <!--
          Hands a decrypted attachment to whichever app can open it. No external
          player reads from memory, so the plaintext has to touch the filesystem;
          this keeps it inside the app's cache and grants one file per Intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Home-screen widget: names and an unread count, never message text. A
          widget sits on a locked home screen where anyone can read it.
        -->
        <receiver
            android:name=".widget.RelayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/relay_widget_info" />
        </receiver>

        <!--
          Receives contentless FCM wakes. The payload never carries message text
          by default: the service fetches the envelope from the relay, decrypts
          it on-device and acks it, so Google's infrastructure sees only that
          something arrived.
        -->
        <service
            android:name=".push.RelayMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>